# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowboard?schema=public"

# Auth.js / NextAuth (generate: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="FlowBoard <notifications@yourdomain.com>"
CRON_SECRET=""

# Google OAuth (optional — omit to use email/password only)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (Phase 5+ — password reset & notifications)
EMAIL_FROM="FlowBoard <noreply@yourdomain.com>"
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"

# File storage (Phase 4+)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# AI (Phase 8)
ANTHROPIC_API_KEY=""

# Realtime (Phase 5 — e.g. Supabase or custom Socket server URL)
REALTIME_URL=""
